#############################################
# Rule for generating Fortran dependencies.

rule Fortran_PREPROCESS_SCAN__OPS_SysOfEqn_f_Release
  depfile = $DEP_FILE
  command = /usr/bin/gfortran -cpp $DEFINES $INCLUDES $FLAGS -E $in -o $out && /usr/bin/cmake -E cmake_ninja_depends --tdi=SRC/system_of_eqn/linearSOE/sparseSYM/CMakeFiles/OPS_SysOfEqn_f.dir/FortranDependInfo.json --lang=Fortran --pp=$out --dep=$DEP_FILE --obj=$OBJ_FILE --ddi=$DYNDEP_INTERMEDIATE_FILE
  description = Building Fortran preprocessed $out


#############################################
# Rule for generating Fortran dependencies on non-preprocessed files.

rule Fortran_SCAN__OPS_SysOfEqn_f_Release
  depfile = $DEP_FILE
  command = /usr/bin/cmake -E cmake_ninja_depends --tdi=SRC/system_of_eqn/linearSOE/sparseSYM/CMakeFiles/OPS_SysOfEqn_f.dir/FortranDependInfo.json --lang=Fortran --pp=$in --dep=$DEP_FILE --obj=$OBJ_FILE --ddi=$out
  description = Generating Fortran dependencies for $in


